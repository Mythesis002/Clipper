# Copy to .env; never commit the filled .env file.
# PostgreSQL
POSTGRES_PASSWORD=change-this
DATABASE_URL=postgresql://clipper:change-this@localhost:5432/clipper
CLIPPER_USER_ID=replace-with-user-uuid
CLIPPER_USER_EMAIL=owner@example.com
CLIPPER_TIMEZONE=Asia/Kolkata
MAX_LATE_MINUTES=20

# Generate once: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Store this key in a secret manager in production. It is needed to decrypt tokens.
TOKEN_ENCRYPTION_KEY=replace-with-base64url-32-byte-key

# Bootstrap-only credentials: bootstrap_user.py encrypts these into PostgreSQL.
# Do not pass these plaintext values to the long-running containers.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v25.0
YT_TOKEN_JSON=
YT_CHANNEL_ID=

# Source rights: explicit truthful attestation applied to each permission:true source.
SOURCE_RIGHTS_ATTESTATION=I confirm I own, license, or have explicit permission to repost each enabled source.

# Gemini (needed by worker pipeline)
GEMINI_API_KEY=

# S3-compatible storage (MinIO locally, Cloudflare R2/AWS in deployment)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=clipper-local
S3_SECRET_ACCESS_KEY=change-this
S3_BUCKET=clipper-media
S3_REGION=us-east-1

CLIPPER_STATE_BACKEND=postgres
CLIPPER_JOB_HANDLER_MODULE=scheduler.clipper_handlers
YOUTUBE_ENABLED=true
PUBLISH_CONCURRENCY=150 # per dispatcher; 2 replicas target 300 concurrent slots
