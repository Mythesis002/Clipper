# PostgreSQL
POSTGRES_PASSWORD=change-this
DATABASE_URL=postgresql://clipper:change-this@localhost:5432/clipper
CLIPPER_USER_ID=replace-with-user-uuid
# Existing Phase 1 single-tenant IG credentials; never commit actual secrets.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v25.0
GEMINI_API_KEY=
YT_TOKEN_JSON=
# S3-compatible storage (MinIO locally, Cloudflare R2/AWS in deployment)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=clipper-local
S3_SECRET_ACCESS_KEY=change-this
S3_BUCKET=clipper-media
S3_REGION=us-east-1
CLIPPER_STATE_BACKEND=postgres
CLIPPER_JOB_HANDLER_MODULE=scheduler.clipper_handlers

YOUTUBE_ENABLED=true
PUBLISH_CONCURRENCY=150 # per dispatcher; with 2 replicas target 300 active slots
